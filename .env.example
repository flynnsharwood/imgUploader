# imgchest API keys: https://imgchest.com/profile/api
# Every variable is a separate account.
IMG_CHEST_API_KEY=
# IMG_CHEST_API_KEY_MAIN=
# IMG_CHEST_API_KEY_2=
# IMG_CHEST_ACCOUNTS=main,2        # optional: the order to try them in

# PostgreSQL connection (any libpq URL or "key=value" string)
DATABASE_URL=postgresql://postgres:password@localhost:5432/boards

# optional: catbox user hash, so catbox uploads show up in your catbox account
CATBOX_USERHASH=
